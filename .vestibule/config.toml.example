# Example Vestibule Configuration
# Copy this to .vestibule/config.toml

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------

[tool.vestibule]
host = "localhost"
port = 8080
transport = "stdio"  # or "http-sse"
log-level = "info"

# -----------------------------------------------------------------------------
# Approval Workflow (human-in-the-loop)
# -----------------------------------------------------------------------------
# Approval policy is declared by each plugin via the vestibule_approval_policy
# hook (co-located with the tools it governs). The operator only enables
# approval globally and can override individual tools.
#
# enabled: global switch. false disables all approval gating.
# overrides: per-tool operator overrides (tool name -> its own mode).
#   never      - no approval required
#   first_only - first call to a gated tool needs approval, then sticky
#   always     - every call to a gated tool needs approval
#
# Effective mode for a tool: operator override -> plugin policy -> not gated.

[tool.vestibule.approval]
enabled = true

[tool.vestibule.approval.overrides]
send_email = "never"
other_plugin_tool = "always"

# -----------------------------------------------------------------------------
# Rate Limiting (requests per minute per tool)
# -----------------------------------------------------------------------------

[tool.vestibule.rate_limits]
send_email = 10
list_whitelist = 120

# -----------------------------------------------------------------------------
# Email Plugin Configuration
# -----------------------------------------------------------------------------

[tool.vestibule.plugins.email]
smtp_host = "smtp.gmail.com"
smtp_port = 587
smtp_use_tls = true
sender_email = "you@gmail.com"
sender_name = "Your Name"
default_recipient = "alice"

# Whitelist: friendly name -> email address mapping
[tool.vestibule.plugins.email.whitelist]
alice = "alice@example.com"
bob = "bob@example.com"
charlie = "charlie@company.com"
team = "team@company.com"
