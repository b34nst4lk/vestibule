# Example .env file for Vestibule with Email Plugin
# Copy this to .env and fill in your actual values

# -----------------------------------------------------------------------------
# Email Plugin Configuration
# -----------------------------------------------------------------------------

# Required: SMTP password or app-specific password
EMAIL_SMTP_PASSWORD=your_app_password_here

# Required: Sender email address
EMAIL_SENDER_EMAIL=you@gmail.com

# Optional: SMTP server hostname (default: smtp.gmail.com)
EMAIL_SMTP_HOST=smtp.gmail.com

# Optional: SMTP port (default: 587)
EMAIL_SMTP_PORT=587

# Optional: Use TLS (default: true)
EMAIL_SMTP_USE_TLS=true

# Optional: SMTP username (defaults to sender_email if not set)
EMAIL_SMTP_USER=you@gmail.com

# Optional: Sender name for From header
EMAIL_SENDER_NAME=Your Name

# Required: Whitelist as JSON string
# Maps friendly names to actual email addresses
EMAIL_WHITELIST={"alice": "alice@example.com", "bob": "bob@example.com", "team": "team@company.com"}

# Optional: Default recipient friendly name
EMAIL_DEFAULT_RECIPIENT=alice
